# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# Pakai anon key ATAU publishable key (nama baru). Keduanya didukung kode.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Service role key (RAHASIA, server-only) — WAJIB agar /api/telemetry menulis ke DB.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Gemini AI
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
# Opsional — model utama Gemini. Default: gemini-2.5-flash (fallback otomatis ke 1.5-flash / 2.0-flash)
GEMINI_MODEL=

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_VOICE_INPUT=true
NEXT_PUBLIC_ENABLE_TELEMETRY=true